{
  "name": "frescy-motion",
  "version": "1.0.0",
  "private": true,
  "description": "Vidéos de lancement FRESCY (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "render:vertical": "remotion render Frescy-Vertical out/frescy-vertical-9x16.mp4 --codec=h264 --crf=16",
    "render:horizontal": "remotion render Frescy-Horizontal out/frescy-horizontal-16x9.mp4 --codec=h264 --crf=16",
    "typecheck": "tsc --noEmit",
    "render:vertical-b": "remotion render Frescy-Vertical-B out/frescy-vertical-B-net-9x16-60fps.mp4 --codec=h264 --crf=12 --image-format=png --x264-preset=slow"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/fonts": "4.0.540",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@fontsource/anton": "5.2.7",
    "@fontsource/caveat": "5.2.8",
    "@fontsource/inter": "5.2.8",
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
